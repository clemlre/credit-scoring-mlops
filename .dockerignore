# Contexte de build réduit au strict nécessaire (sans lui, les 2,6 Go de données
# Kaggle et le venv partiraient au démon à chaque build).

# Environnements et caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Données et artefacts d'entraînement
data/
output/
mlruns/
mlruns.db
mlartifacts/
*.parquet

# Code non déployé : il n'est ni copié par le Dockerfile, ni utile au build
notebooks/
tests/
docs/
monitoring/
src/
scripts/
.streamlit/

# Modèles au format non déployé (seul credit_default_lgbm.txt part dans l'image)
models/*.pkl
models/*.joblib
models/*.onnx

# Pile de developpement local : jamais dans le contexte de build de l image
docker-compose.yml
docker-compose.*.yml

# Git et CI
.git/
.github/
.gitignore
.gitattributes

# Documentation et divers
*.md
!README.md
.vscode/
.idea/
.env
.env.*
