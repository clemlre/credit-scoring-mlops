# Modèle de configuration locale — copier en `.env` et adapter.
# `.env` est ignoré par Git : aucun mot de passe réel ne doit être versionné.
#
#   cp .env.example .env
#
# Ces valeurs ne servent QUE au docker compose de développement. En production,
# DATABASE_URL arrive par un secret du pipeline ou de l'hébergeur.

POSTGRES_USER=scoring
POSTGRES_PASSWORD=scoring_dev
POSTGRES_DB=monitoring
POSTGRES_PORT=5432

# Port hôte de l'API (le port interne du conteneur reste 8000).
API_PORT=8000

# Racine du projet de la Partie 1 (données Kaggle, registre MLflow). Lue par les
# tests de fidélité, les scripts d'analyse et l'export du modèle.
# P6_PROJECT_ROOT=/chemin/vers/projet-partie-1

# Console pgAdmin (profil `outils`), accessible sur http://localhost:5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin_dev
