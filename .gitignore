# --- Environnements Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Données Home Credit (Kaggle) ---
# ~2,6 Go de CSV bruts : jamais dans un dépôt public (poids + licence Kaggle).
# Voir data/README.md pour les récupérer.
data/*
!data/README.md

# Dataset de features agrégées (~280 Mo), reproductible via src/prepare_data.py
*.parquet

# --- Tracking MLflow (hérité de la Partie 1) ---
mlruns/
mlruns.db
mlartifacts/
output/

# --- Artefacts de modèle sérialisés ---
# Les formats qui embarquent du code exécutable (pickle) restent hors du dépôt :
# on ne recharge pas un pickle venu d'un dépôt public, et il exige les versions
# exactes de scikit-learn/LightGBM du jour de l'entraînement.
models/*.pkl
models/*.joblib
models/*.onnx

# Exception assumée : l'artefact déployable au format texte natif LightGBM (5,4 Mo).
# Il EST versionné, parce que l'API, les tests et l'image Docker doivent pouvoir
# fonctionner sans accès au registre MLflow de la Partie 1 (qui vit hors dépôt).
# Il est reproductible à l'identique via `python src/export_model.py`.
# En contexte industriel, cet artefact vivrait dans un registre de modèles ou un
# artifact store, pas dans Git — c'est un compromis de projet, pas un idéal.
models/*.txt
!models/credit_default_lgbm.txt

# --- Données de production / monitoring (étape 3) ---
monitoring/logs/
*.log

# --- Secrets : jamais en clair, même dans un dépôt privé ---
.env
.env.*
*.pem
*.key
secrets/

# --- OS / éditeurs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
